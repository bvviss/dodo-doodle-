// Cloudflare settings for Doodle Chain.
// "name" decides your web address: https://<name>.<your-account>.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doodle-chain",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Any unknown path (like /r/ABCD) loads the app.
    "not_found_handling": "single-page-application",
    // Only /api/* requests go to the game server code.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  // The free plan only allows SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "observability": { "enabled": true }
}
